# ---------- Server ----------
PORT=3000
# Comma-separated list of allowed frontend origins (use your Vercel URL in production)
CORS_ORIGIN=http://localhost:5173

# ---------- Database (phpMyAdmin / MySQL) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafe_pos
# Set to true for cloud MySQL providers that require SSL (Aiven, TiDB Cloud, etc.)
DB_SSL=false

# ---------- Auth ----------
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---------- Shop settings ----------
SHOP_NAME=Brew & Bean
CURRENCY=USD
# Tax percentage applied to (subtotal - discount). 0 = no tax
TAX_RATE=0
# Your local UTC offset, used to group reports by local day. e.g. +07:00, -05:00, +00:00
SHOP_TZ_OFFSET=+00:00
LOW_STOCK_THRESHOLD=5
